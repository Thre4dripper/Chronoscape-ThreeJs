{
  "name": "chronoscape",
  "private": true,
  "version": "0.1.0",
  "description": "An illustrated atlas of the world's cities through time: hand-drawn maps of 36 historic cities, their eras, and monuments that rise in 3D.",
  "license": "(MIT AND CC-BY-NC-4.0)",
  "author": "Ijlal Ahmad",
  "homepage": "https://chronoscape.ijlalahmad.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thre4dripper/Chronoscape-ThreeJs.git"
  },
  "bugs": "https://github.com/Thre4dripper/Chronoscape-ThreeJs/issues",
  "keywords": ["history", "historical-maps", "atlas", "ancient-cities", "threejs", "react-three-fiber", "webgl", "3d", "blender", "education"],
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm validate && tsc -p tsconfig.json --noEmit && vite build && node scripts/bake-plates.mjs --out dist/plates && tsx scripts/build-pages.ts",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets:build": "tools/blender/build_all.sh",
    "plates:bake": "node scripts/bake-plates.mjs",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  }
}
